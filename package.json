{
  "name": "opora",
  "version": "0.1.0",
  "description": "Единая память проекта Godot для Claude и Codex",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node test/core.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check src/core.cjs && node --check ui/context.js && node --check ui/app.js",
    "package:win": "electron-packager . Opora --platform=win32 --arch=x64 --out=release --electron-version=45.2.3 --overwrite --prune=true --ignore=^/release --ignore=^/test --ignore=^/docs --ignore=^/scripts --ignore=^/distribution --ignore=^/Opora-App --ignore=^/Opora-demo.html --ignore=^/START-OPORA.cmd --ignore=^/package-lock.json --ignore=^/.git"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.3",
    "playwright-core": "1.64.1"
  }
}
